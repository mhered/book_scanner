[Unit]
Description=Book Scanner CSV upload API
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/apps/book_scanner
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=%h/apps/book_scanner/.env
ExecStart=%h/apps/book_scanner/.venv/bin/uvicorn main:app --host ${BOOK_SCANNER_BIND_HOST} --port ${BOOK_SCANNER_PORT}
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=%h/apps/book_scanner

[Install]
WantedBy=default.target
